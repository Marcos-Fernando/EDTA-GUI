# EDTA-GUI backend configuration. Copy to gui/backend/.env (optional) or export the variables.
# Commented paths show the defaults, computed from this repository location.

HOST=127.0.0.1
PORT=8000

# New runs (read/write) and legacy runs (read-only, ':'-separated; missing folders are ignored)
# RESULTS_DIR=/path/to/EDTA-GUI/gui/backend/results
# LEGACY_RESULTS_DIRS=/path/to/older/results   (optional; empty by default)

# Repository root (EDTA.pl, panEDTA.sh, bin/) and AnnoTEP folder
# EDTA_DIR=/path/to/EDTA-GUI
# ANNOTEP_DIR=/path/to/EDTA-GUI/AnnoTEP

# Conda used to run the pipelines: EDTAgui for EDTA and panEDTA, annotepgui_3_11 for AnnoTEP
# CONDA_EXE=/home/<user>/miniconda3/bin/conda
EDTA_CONDA_ENV=EDTAgui
ANNOTEP_CONDA_ENV=annotepgui_3_11

# Runs at the same time; the others wait in a queue
MAX_CONCURRENT_RUNS=1
MAX_UPLOAD_GB=10
LOG_MAX_LINES=20000
CANCEL_GRACE_SECONDS=10

# CORS origin of the Vite dev server
FRONTEND_DEV_ORIGIN=http://localhost:5173
# Host names this server answers to (comma-separated). Others get 400 (blocks DNS rebinding),
# and POSTs from pages of other sites get 403 (blocks CSRF). Add a name only if you open the
# interface through it.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Built web interface, served at / when it exists (npm run build). Default: gui/frontend/dist
# FRONTEND_DIST=/path/to/EDTA-GUI/gui/frontend/dist

# Docker only: show result folders with their address on the user's machine.
# Format: container_dir=host_dir;container_dir=host_dir (filled by gui/compose.yaml)
# DISPLAY_PATH_MAP=

# E-mail (disabled while MAIL_SERVER is empty). Never commit real credentials.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=noreply@app.com
MAIL_MAX_ATTACHMENT_MB=10
