# Engine used by the UI:
#   (unset) or false → the FastAPI backend (default)
#   true             → in-browser mock with simulated runs (no backend needed)
VITE_USE_MOCK=false

# Backend origin. Empty = same origin: the Vite dev server proxies /api to BACKEND_URL
# (default http://127.0.0.1:8000, see vite.config.ts).
VITE_API_BASE=
