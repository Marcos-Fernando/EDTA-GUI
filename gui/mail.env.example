# Optional: e-mail when an annotation starts and ends.
# Copy to gui/mail.env, fill in YOUR account and restart (./start.sh).
# This file holds a password: do not share it and never commit it.
#
# Gmail: use an "app password" (needs 2-Step Verification):
#   https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your.name@gmail.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=your.name@gmail.com
