#!/usr/bin/env bash
# The EDTA-GUI web interface without Docker. Runs the server (gui/backend, FastAPI) in the
# annotepgui_3_11 environment and opens http://localhost:8000. Stop it with Ctrl+C.
#
#   EDTA-GUI                     start (the first time it also builds the interface)
#   EDTA-GUI --build             only build the interface (after updating the repository)
#   EDTA_GUI_PORT=8080 EDTA-GUI  another port
#
# Results: EDTA-GUI/gui/backend/results (another folder: RESULTS_DIR=/path EDTA-GUI).
# E-mail and other settings: gui/backend/.env (see gui/backend/.env.example).
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/_common.sh"

FRONTEND="$ROOT/gui/frontend"
PORT="${EDTA_GUI_PORT:-8000}"
URL="http://localhost:${PORT}"

# Node and npm come from the annotepgui_3_11 environment.
build_interface() {
  echo "Building the web interface (only once, needs internet)..."
  run_in "$ANNOTEP_ENV" "" npm --prefix "$FRONTEND" ci --no-audit --no-fund
  run_in "$ANNOTEP_ENV" "" npm --prefix "$FRONTEND" run build
}

case "${1:-}" in
  "") [ -f "$FRONTEND/dist/index.html" ] || build_interface ;;
  --build) build_interface; exit 0 ;;
  *) echo "Unknown option: $1 (use: EDTA-GUI or EDTA-GUI --build)" >&2; exit 1 ;;
esac

# Opens the browser once the server answers (curl when installed; otherwise only the address).
open_when_ready() {
  command -v curl >/dev/null 2>&1 || return 0
  local _
  for _ in $(seq 1 60); do
    sleep 2
    if curl -fsS "${URL}/api/health" >/dev/null 2>&1; then
      echo "EDTA-GUI is ready: ${URL}  (stop with Ctrl+C)"
      if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$URL" >/dev/null 2>&1 || true
      fi
      return 0
    fi
  done
}
open_when_ready &

echo "Starting EDTA-GUI at ${URL} ..."
cd "$ROOT/gui/backend"
run_in "$ANNOTEP_ENV" "" uvicorn app.main:app --host 127.0.0.1 --port "$PORT"
